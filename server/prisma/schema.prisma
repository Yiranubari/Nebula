generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
}

/// A tenant boundary. Every user, task, track, message, DM, and notification
/// belongs to exactly one workspace and is invisible to other workspaces.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner         User            @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members       User[]          @relation("WorkspaceMembers")
  tasks         Task[]
  tracks        Track[]
  messages      Message[]
  directMessages DirectMessage[]
  notifications Notification[]

  @@map("workspaces")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DMStatus {
  SENT
  FAILED
}

enum NotificationType {
  APPROVAL_REQUEST
  ASSIGNED
  MENTION
  REACTION
}

enum NotifStatus {
  PENDING
  APPROVED
  REJECTED
  INFO
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(MEMBER)
  avatar       String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  isVerified   Boolean   @default(false) @map("is_verified")
  otp          String?
  otpExpiresAt DateTime? @map("otp_expires_at")
  invitedById  String?   @map("invited_by_id")

  /// Tenant: every user lives inside exactly one workspace. Nullable for the
  /// split-second during signup between User insert and Workspace insert — the
  /// auth service sets it within the same transaction.
  workspaceId  String?   @map("workspace_id")
  workspace    Workspace? @relation("WorkspaceMembers", fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Workspaces where this user is the sole owner (always length 1 for admins,
  /// 0 for regular members).
  ownedWorkspaces       Workspace[]     @relation("WorkspaceOwner")

  assignedTasks         Task[]          @relation("AssignedTasks")
  messages              Message[]
  sentDMs               DirectMessage[] @relation("SentDMs")
  receivedDMs           DirectMessage[] @relation("ReceivedDMs")
  tracks                TrackMember[]
  refreshTokens         RefreshToken[]
  sentNotifications     Notification[]  @relation("RequesterNotifications")
  receivedNotifications Notification[]  @relation("RecipientNotifications")
  invitedBy             User?           @relation("UserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers          User[]          @relation("UserInvites")

  @@index([workspaceId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Task {
  id             String     @id @default(cuid())
  workspaceId    String     @map("workspace_id")
  title          String
  description    String     @default("")
  status         TaskStatus @default(TODO)
  priority       Priority   @default(MEDIUM)
  assigneeId     String?    @map("assignee_id")
  estimatedHours Float      @default(0) @map("estimated_hours")
  dueDate        DateTime?  @map("due_date")
  labels         String[]
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee  User?     @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("tasks")
}

model Track {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   TrackMember[]
  messages  Message[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("tracks")
}

model TrackMember {
  trackId String @map("track_id")
  userId  String @map("user_id")

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([trackId, userId])
  @@map("track_members")
}

model Message {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  content     String
  userId      String   @map("user_id")
  trackId     String   @map("track_id")
  parentId    String?  @map("parent_id")
  pinned      Boolean  @default(false)
  attachments Json?
  reactions   Json?
  readBy      String[] @map("read_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  parent    Message?  @relation("ThreadReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("ThreadReplies")

  @@index([workspaceId])
  @@index([workspaceId, trackId])
  @@map("messages")
}

model DirectMessage {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  content     String
  fromUserId  String   @map("from_user_id")
  toUserId    String   @map("to_user_id")
  attachments Json?
  reactions   Json?
  readBy      String[] @map("read_by")
  status      DMStatus @default(SENT)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  from      User      @relation("SentDMs", fields: [fromUserId], references: [id], onDelete: Cascade)
  to        User      @relation("ReceivedDMs", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("direct_messages")
}

model Notification {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  type        NotificationType?
  taskId      String?           @map("task_id")
  messageId   String?           @map("message_id")
  trackId     String?           @map("track_id")
  emoji       String?
  requesterId String            @map("requester_id")
  recipientId String?           @map("recipient_id")
  status      NotifStatus       @default(PENDING)
  read        Boolean           @default(false)
  createdAt   DateTime          @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requester User      @relation("RequesterNotifications", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User?     @relation("RecipientNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("notifications")
}
