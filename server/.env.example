# ─── Runtime ────────────────────────────────────────────────────────────────
# Hosting platforms (Railway/Render/Fly) inject PORT automatically — leave the
# line; envalid just falls through to its default if the platform overrides.
PORT=4000
# Set to "production" on the deploy target. Controls:
#   - trust-proxy (on)
#   - cookie Secure + SameSite=None (for cross-origin frontend)
#   - pino JSON logs (no pretty-print)
#   - Prisma query logging gated behind LOG_QUERIES=true
NODE_ENV=development

# ─── Database ───────────────────────────────────────────────────────────────
# Neon: use the *pooler* URL here (for runtime) and set DIRECT_URL to the
# direct/non-pooled URL so Prisma migrations work.
DATABASE_URL=postgresql://user:password@localhost:5432/nebula
DIRECT_URL=

# ─── Auth secrets ───────────────────────────────────────────────────────────
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# NEVER reuse development secrets in production.
JWT_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cloudinary (file uploads) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── CORS / client origin ───────────────────────────────────────────────────
# In development this is just http://localhost:3000.
# In production, set this to your deployed frontend URL. Supports:
#   - a single origin:       https://app.example.com
#   - comma-separated list:  https://app.example.com,https://staging.example.com
#   - regex (wrap in slashes) to whitelist Vercel preview deploys:
#     https://my-app.vercel.app,/^https:\/\/my-app-.*-yourteam\.vercel\.app$/
CLIENT_URL=http://localhost:3000

# ─── Email ──────────────────────────────────────────────────────────────────
# The mailer picks a provider in this order:
#   1. If RESEND_API_KEY is set → HTTP API (works on Render / Vercel / etc.
#      which block outbound SMTP on ports 25/465/587). This is what you
#      want in production.
#   2. Else, if SMTP_USER + SMTP_PASS are set → SMTP (convenient for local
#      dev with Gmail / Mailtrap).
#   3. Else, no emails are sent (a warning is logged).

# --- Resend (production) ---
# Create a free API key at https://resend.com/api-keys (3k emails/month, no
# card). Verify your sending domain first — unverified accounts can only
# send to the address the Resend account was signed up with.
RESEND_API_KEY=
# Sender identity Resend signs emails as. Format: "Name <email@verified-domain>"
# During Resend's onboarding you can use onboarding@resend.dev for test sends.
EMAIL_FROM=Nebula <onboarding@resend.dev>

# --- SMTP (local dev) ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nebula <noreply@nebula.com>

# ─── Optional debugging ─────────────────────────────────────────────────────
# LOG_QUERIES=true  # echo SQL queries from Prisma (dev only — never in prod logs)
