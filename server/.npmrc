# Render (and other PaaS hosts) set NODE_ENV=production, which makes
# `npm install` skip devDependencies by default. Our build step needs the
# TypeScript compiler, Prisma CLI, and @types/* packages, all of which live
# under devDependencies. `production=false` tells npm to always install them
# regardless of NODE_ENV so `npm run build` can succeed on the deploy host.
production=false
